{
  "name": "@scmposs/hollow-ui",
  "version": "1.0.2",
  "description": "hollow-UI - Modern React Components Framework with Dark Fantasy Design System. Developed by Ítalo Soares Campos",
  "author": "Ítalo Soares Campos <soarescmpos@gmail.com>",
  "license": "MIT",
  "keywords": [
    "react",
    "ui",
    "components",
    "design-system",
    "hollow-ui",
    "dark-fantasy",
    "italo-soares-campos"
  ],
  "homepage": "https://github.com/SCamposs/hollow-ui",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SCamposs/hollow-ui.git"
  },
  "bugs": {
    "url": "https://github.com/SCamposs/hollow-ui/issues"
  },
  "private": false,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "bin": {
    "hollow-ui": "dist/cli.cjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "src/cli",
    "src/registry",
    "README.md"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "build:components": "tsup",
    "build:cli": "tsup --config tsup.cli.config.ts && node scripts/post-build-cli.js",
    "build:css": "npx @tailwindcss/cli -i ./src/app/globals.css -o ./dist/styles.css --minify",
    "build:package": "npm run build:components && npm run build:cli && npm run build:css",
    "prepublishOnly": "npm run build:package",
    "playground": "npm run dev",
    "publish:patch": "npm version patch && npm run build:package && npm publish",
    "publish:minor": "npm version minor && npm run build:package && npm publish",
    "publish:major": "npm version major && npm run build:package && npm publish",
    "test:build": "npm run build:package && npm pack --dry-run"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "chalk": "^4.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "commander": "^11.1.0",
    "date-fns": "^4.1.0",
    "embla-carousel-react": "^8.6.0",
    "fs-extra": "^11.2.0",
    "lucide-react": "^0.533.0",
    "ora": "^5.4.1",
    "react-day-picker": "^9.8.1",
    "react-icons": "^5.5.0",
    "recharts": "^2.15.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@mdx-js/loader": "^3.1.0",
    "@mdx-js/react": "^3.1.0",
    "@next/mdx": "^15.0.3",
    "@tailwindcss/postcss": "^4.1.14",
    "@types/fs-extra": "^11.0.4",
    "@types/mdx": "^2.0.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.21",
    "eslint": "^9",
    "eslint-config-next": "15.5.4",
    "next": "^15.5.12",
    "next-themes": "^0.4.6",
    "postcss": "^8.5.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tailwindcss": "^4.1.14",
    "tsup": "^8.0.0",
    "tw-animate-css": "^1.3.6",
    "typescript": "^5"
  }
}
