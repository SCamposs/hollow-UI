{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "incremental": false,
    "declaration": true,
    "emitDeclarationOnly": false,
    "outDir": "./dist"
  },
  "include": ["src/index.ts", "src/registry/**/*", "src/lib/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "src/app/**/*",
    "src/components/layout/**/*",
    "src/contexts/**/*"
  ]
}
